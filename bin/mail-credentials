#!/usr/bin/env bash
# Gives WordPress SMTP credentials for Amazon SES (infra/mail) and points its mail there:
# creates a new access key for the sender IAM user, turns it into an SES SMTP password
# here, sends both straight to deploy/mail-install.sh on the server (on stdin, never on a
# command line or in a file), and then deletes the user's older keys. Nothing secret is
# printed or written to disk on this machine. Run it again to rotate the credentials.
#
#   bin/mail-credentials                        # settings from deploy/site.env
#   SITE_ENV=/path/to/site.env bin/mail-credentials
#
# Settings: DEPLOY_SSH, DEPLOY_SSH_KEY, PLATFORM, WP_HOST, MCP_HOST, SITE_NAME, and
#   MAIL_AWS_PROFILE   profile of the account with the mail stack (the AWS CLI is used)
#   MAIL_REGION        SES region (default eu-west-1)
#   MAIL_SENDER_USER   the stack's sender_user output (default wp-mail-sender)
#   MAIL_FROM          the From address, one of the stack's from_addresses (default noreply@WP_HOST)
#   MAIL_FROM_NAME     default SITE_NAME
#   MAIL_REPLY_TO      where answers go (optional)
#   MAIL_TEST_TO       send a test message there (optional; while SES is in its sandbox,
#                      it must be a verified address)
source "$(dirname "$0")/lib.sh"

have aws || die "the AWS CLI is required"
ssh_setup DEPLOY
platform="$(site_platform)"
site_conf >/dev/null
wp_host="$(setting WP_HOST)"
profile="$(setting MAIL_AWS_PROFILE)"
region="$(setting MAIL_REGION eu-west-1)"
user="$(setting MAIL_SENDER_USER wp-mail-sender)"
from="$(setting MAIL_FROM "noreply@$wp_host")"
from_name="$(setting MAIL_FROM_NAME "$(setting SITE_NAME WordPress)")"
reply_to="$(setting MAIL_REPLY_TO)"
test_to="$(setting MAIL_TEST_TO)"
[[ -n "$profile" ]] || die "set MAIL_AWS_PROFILE in $SITE_ENV"
[[ "$region" =~ ^[a-z]{2}-[a-z]+-[0-9]$ ]] || die "MAIL_REGION is not an AWS region"
[[ "$user" =~ ^[A-Za-z0-9+=,.@_-]{1,64}$ ]] || die "MAIL_SENDER_USER is not an IAM user name"
aws=(aws --profile "$profile" --region "$region" --output json)

stage="$ROOT/var/mail/stage"
rm -rf "$stage" && mkdir -p "$stage"
cp "$ROOT/deploy/lib.remote.sh" "$ROOT/deploy/mail-install.sh" "$ROOT/wordpress/mail/wp-mail-reply-to.php" "$stage/"
cp "$ROOT/deploy/platform.$platform.sh" "$stage/platform.sh"
{
  site_conf
  printf 'MAIL_HOST=email-smtp.%s.amazonaws.com\nMAIL_FROM=%s\nMAIL_FROM_NAME=%s\nMAIL_REPLY_TO=%s\nMAIL_TEST_TO=%s\n' \
    "$region" "$from" "$from_name" "$reply_to" "$test_to"
} >"$stage/site.conf"

old_keys="$("${aws[@]}" iam list-access-keys --user-name "$user" --query 'AccessKeyMetadata[].AccessKeyId' --output text)"
info "new access key for $user (account of profile $profile)"
key_json="$("${aws[@]}" iam create-access-key --user-name "$user")"
# The SES SMTP password: HMAC-SHA256 chain over the secret key (AWS's documented algorithm).
# Two lines out: the access key id (the SMTP user) and the password. Kept in this shell only.
creds="$(REGION="$region" python3 -I -c '
import base64, hashlib, hmac, json, os, sys
key = json.load(sys.stdin)["AccessKey"]
def sign(k, m): return hmac.new(k, m.encode(), hashlib.sha256).digest()
s = sign(("AWS4" + key["SecretAccessKey"]).encode(), "11111111")
for part in (os.environ["REGION"], "ses", "aws4_request", "SendRawEmail"):
    s = sign(s, part)
print(key["AccessKeyId"])
print(base64.b64encode(b"\x04" + s).decode())
' <<<"$key_json")"
new_key="${creds%%$'\n'*}"
unset key_json

info "installing on $ssh_target ($platform)"
# shellcheck disable=SC2016 # expanded on the server
if { printf '%s\n' "$creds"; tar -C "$stage" -cz .; } | ssh "${ssh_args[@]}" "$ssh_target" \
  'IFS= read -r u; IFS= read -r p; d="$(mktemp -d)"; trap "rm -rf \"$d\"" EXIT; tar -C "$d" -xz &&
   printf "%s\n%s\n" "$u" "$p" | sudo -n bash "$d/mail-install.sh" "$d"'; then
  unset creds
  for key in $old_keys; do
    [[ "$key" == "$new_key" ]] && continue
    "${aws[@]}" iam delete-access-key --user-name "$user" --access-key-id "$key"
    info "deleted the previous key ${key:0:8}…"
  done
  ok "WordPress sends through SES as $from"
else
  unset creds
  "${aws[@]}" iam delete-access-key --user-name "$user" --access-key-id "$new_key"
  die "install failed: the new key was deleted, the previous one (if any) still works"
fi
