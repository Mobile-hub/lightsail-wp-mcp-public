#!/usr/bin/env bash
# Gives a FRESH WordPress site what wpmcp expects: Polylang with the languages of
# SITE_LANGUAGES (the first is the default), All in One SEO active, "post name" permalinks.
# Not for a site with content of its own (a migrated one already has all that).
# Run after bin/setup-server.
#
#   bin/bootstrap-site                          # settings from deploy/site.env
#   SITE_ENV=/path/to/site.env bin/bootstrap-site
#
# Settings: DEPLOY_SSH, DEPLOY_SSH_KEY, PLATFORM, WP_HOST, MCP_HOST, optional
# SITE_LANGUAGES (WordPress locales; default en_US).
source "$(dirname "$0")/lib.sh"

ssh_setup DEPLOY
platform="$(site_platform)"
site_conf >/dev/null
languages="$(setting SITE_LANGUAGES en_US)"
[[ "$languages" =~ ^[a-z]{2,3}(_[A-Z]{2})?(,[a-z]{2,3}(_[A-Z]{2})?)*$ ]] || die "SITE_LANGUAGES: locales such as en_GB,es_ES"

stage="$ROOT/var/bootstrap/stage"
rm -rf "$stage" && mkdir -p "$stage"
cp "$ROOT/deploy/lib.remote.sh" "$ROOT/deploy/bootstrap-site.sh" "$ROOT/deploy/bootstrap-languages.php" "$stage/"
cp "$ROOT/deploy/platform.$platform.sh" "$stage/platform.sh"
{ site_conf; printf 'SITE_LANGUAGES=%s\n' "$languages"; } >"$stage/site.conf"
info "bootstrap of the site on $ssh_target ($platform)"

ship "$stage" bootstrap-site.sh
ok "site ready: next, bin/deploy"
