#!/usr/bin/env bash
# Builds a release and installs it on the server (deploy/remote-install.sh, as root).
#
#   bin/deploy                                  # settings from deploy/site.env
#   SITE_ENV=/path/to/site.env bin/deploy       # or from a file kept elsewhere
#
# Settings (see deploy/site.env.example): DEPLOY_SSH, DEPLOY_SSH_KEY, PLATFORM, MCP_HOST,
# WP_HOST, SITE_NAME, optional ACME_EMAIL, EXTRA_MU_PLUGINS and WPMCP_* overrides. Each can
# also come from the environment. PLATFORM picks deploy/platform.<name>.sh and
# deploy/apache/<name>/.
#
# Ships: the wheel, the hash-pinned requirements, the bridge mu-plugin (plus any extra
# mu-plugins), the systemd units, Apache vhosts rendered for MCP_HOST, settings without
# secrets and a fresh client egress list. Runs the test suite first; set
# DEPLOY_SKIP_TESTS=1 to skip it.
source "$(dirname "$0")/lib.sh"

ssh_setup DEPLOY
platform="$(site_platform)"
site_conf >/dev/null
mcp_host="$(setting MCP_HOST)"
wp_host="$(setting WP_HOST)"
site_name="$(setting SITE_NAME WordPress)"
extra_mu="$(setting EXTRA_MU_PLUGINS)"
# wpmcp.env is read by systemd and sourced by wpmcp-admin: keep values shell-inert.
shell_safe() { [[ "$1" != *[\"\$\`\\]* && "$1" != *$'\n'* ]]; }
shell_safe "$site_name" || die "SITE_NAME must not contain quotes, \$, backticks or backslashes"
[[ -z "$extra_mu" || -d "$extra_mu" ]] || die "EXTRA_MU_PLUGINS is not a directory: $extra_mu"

[[ "${DEPLOY_SKIP_TESTS:-}" == 1 ]] || "$ROOT/bin/test"

stage="$ROOT/var/deploy/stage"
rm -rf "$stage" && mkdir -p "$stage/apache" "$stage/mu-plugins/extra" "$stage/systemd"
run_uv build --wheel --quiet --out-dir "$stage" >/dev/null
"$ROOT/bin/cidrs-update" >"$stage/cidrs.txt"
cp "$ROOT/deploy/requirements.txt" "$ROOT/deploy/wpmcp-admin" "$ROOT/deploy/remote-install.sh" \
  "$ROOT/deploy/lib.remote.sh" "$stage/"
cp "$ROOT/deploy/platform.$platform.sh" "$stage/platform.sh"
cp "$ROOT"/deploy/systemd/* "$stage/systemd/"
cp -r "$ROOT/wordpress/mu-plugins/wpmcp-bridge.php" "$ROOT/wordpress/mu-plugins/wpmcp-bridge" \
  "$stage/mu-plugins/"
if [[ -n "$extra_mu" ]]; then
  find "$extra_mu" -maxdepth 1 -type f -name '*.php' -exec cp {} "$stage/mu-plugins/extra/" \;
fi

# Templates: @MCP_HOST@, @WP_HOST@ and @SITE_NAME@ are replaced; nothing else is expanded.
vars=("MCP_HOST=$mcp_host" "WP_HOST=$wp_host" "SITE_NAME=$site_name")
render "$ROOT/deploy/wpmcp.env" "$stage/wpmcp.env" "${vars[@]}"
for conf in "$ROOT/deploy/apache/$platform"/mcp-*.conf; do
  render "$conf" "$stage/apache/$(basename "$conf")" "${vars[@]}"
done
# WPMCP_* lines of the site file override the defaults (the last assignment wins).
if [[ -f "$SITE_ENV" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^WPMCP_[A-Z0-9_]+= ]] || continue
    value="${line#*=}"; value="${value%\"}"; value="${value#\"}"
    shell_safe "$value" || die "unsafe value in $SITE_ENV: ${line%%=*}"
    printf '%s="%s"\n' "${line%%=*}" "$value" >>"$stage/wpmcp.env"
  done <"$SITE_ENV"
fi
site_conf >"$stage/site.conf"
python3 -c 'import tomllib,sys; print(tomllib.load(open(sys.argv[1],"rb"))["project"]["version"])' \
  "$ROOT/pyproject.toml" >"$stage/VERSION"
info "release $(cat "$stage/VERSION") for $mcp_host -> $ssh_target ($platform)"

ship "$stage" remote-install.sh
ok "deployed"
