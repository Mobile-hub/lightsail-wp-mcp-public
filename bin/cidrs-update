#!/usr/bin/env bash
# Writes the egress ranges of the MCP clients, one CIDR per line, to stdout:
# Anthropic (published, fixed list below) and OpenAI (fetched from its published JSON).
#
#   bin/cidrs-update > var/deploy/cidrs.txt
#
# The server re-reads the file when it changes. Ranges are checked before being written.
source "$(dirname "$0")/lib.sh"

OPENAI_URL="https://openai.com/chatgpt-connectors.json"
# https://docs.anthropic.com/en/api/ip-addresses (outbound, for MCP connectors)
ANTHROPIC=("160.79.104.0/21" "153.61.208.0/20")

json="$(curl -fsSL --max-time 30 --proto '=https' "$OPENAI_URL")" || die "cannot fetch $OPENAI_URL"

python3 -I - "${ANTHROPIC[@]}" <<<"$json" 3<&0 <<'PY'
import ipaddress, json, re, sys

def walk(node):
    if isinstance(node, dict):
        for value in node.values():
            yield from walk(value)
    elif isinstance(node, list):
        for value in node:
            yield from walk(value)
    elif isinstance(node, str) and re.fullmatch(r"[0-9a-fA-F:.]+/\d{1,3}", node):
        yield node

data = json.loads(open(3).read())
openai = sorted({str(ipaddress.ip_network(c, strict=False)) for c in walk(data)})
if len(openai) < 10:
    sys.exit(f"only {len(openai)} OpenAI ranges found: the file format may have changed")
anthropic = [str(ipaddress.ip_network(c, strict=False)) for c in sys.argv[1:]]
print("# MCP client egress ranges, generated by bin/cidrs-update")
print(f"# anthropic: {len(anthropic)}")
print("\n".join(anthropic))
print(f"# openai: {len(openai)}")
print("\n".join(openai))
PY
