# Copy to terraform.tfvars (git-ignored) or keep it outside the repository and pass
# -var-file=/path/to/instance.tfvars.
name                = "my-site"
region              = "eu-west-1"
aws_profile         = "default"
ssh_public_key_path = "~/.ssh/my-site.pub"
ssh_cidrs           = ["203.0.113.10/32"]
auto_snapshots      = true
