# Local development (bin/setup writes a working .env). In production these come from the
# systemd unit, and the signing secret from a systemd credential, never from a file here.

# Signing key for access tokens and consent requests (>= 32 chars). Production: leave unset
# and provide the credential "wpmcp-secret" (LoadCredential=) or WPMCP_SECRET_FILE.
WPMCP_SECRET=
# Public origin of this server: the OAuth issuer, and with /mcp the token audience.
WPMCP_PUBLIC_URL=http://127.0.0.1:8080
# Allow the http:// URL above. Never set in production.
WPMCP_INSECURE_DEV=true
# SQLite file with the owner, clients, grants and refresh tokens (created with mode 600).
WPMCP_DB=var/wpmcp.sqlite
# Shown on the consent screen and to the model.
WPMCP_SITE_NAME=WordPress (dev)

# --- listener: loopback TCP, or a Unix socket behind the reverse proxy
#WPMCP_HOST=127.0.0.1
#WPMCP_PORT=8080
#WPMCP_UDS=/run/wpmcp/wpmcp.sock
#WPMCP_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# --- client egress allowlist for /mcp and /token: off | monitor | enforce
#WPMCP_CIDR_MODE=off
#WPMCP_CIDR_FILE=/etc/wpmcp/cidrs.txt

# --- lifetimes in seconds
#WPMCP_ACCESS_TOKEN_TTL=900
#WPMCP_REFRESH_TOKEN_TTL=1209600
#WPMCP_REFRESH_GRACE=60
#WPMCP_AUTH_CODE_TTL=120
