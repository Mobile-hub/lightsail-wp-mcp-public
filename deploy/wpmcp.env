# /etc/wpmcp/wpmcp.env - read by the systemd unit and by wpmcp-admin (keep values quoted).
# A template: bin/deploy fills in MCP_HOST, WP_HOST and SITE_NAME from the site file
# (deploy/site.env.example) and appends that file's WPMCP_* lines after these defaults.
# No secrets here: the signing key and the WordPress Application Password are systemd
# credentials (/etc/wpmcp/secret, /etc/wpmcp/wp-app-password).
WPMCP_PUBLIC_URL="https://@MCP_HOST@"
WPMCP_SITE_NAME="@SITE_NAME@"
WPMCP_DB="/var/lib/wpmcp/wpmcp.sqlite"
WPMCP_UDS="/run/wpmcp/wpmcp.sock"
WPMCP_CIDR_MODE="monitor"
WPMCP_CIDR_FILE="/etc/wpmcp/cidrs.txt"
WPMCP_WP_URL="https://@WP_HOST@"
WPMCP_WP_USER="wpmcp"
WPMCP_WP_CONNECT_IP="127.0.0.1"
# Images are decoded, re-encoded and downloaded by the sandboxed worker (wpmcp-media@.service).
WPMCP_MEDIA_SOCKET="/run/wpmcp-media.sock"
