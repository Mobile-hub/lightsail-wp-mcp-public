# Settings of one deployment, read by bin/deploy and bin/inventory. Copy this file to
# deploy/site.env (git-ignored), or keep it anywhere and point SITE_ENV at it:
#   SITE_ENV=~/my-site/site.env bin/deploy
# No secrets here: the server creates its own and never sends them back.

# SSH target (a user with passwordless sudo) and its key.
DEPLOY_SSH=bitnami@203.0.113.10
DEPLOY_SSH_KEY=~/.ssh/my-instance.pem
# bin/inventory uses the same target unless INVENTORY_SSH / INVENTORY_SSH_KEY are set.
# Optional: a known_hosts file for this server only (e.g. from ssh-keyscan, checked).
#DEPLOY_KNOWN_HOSTS=~/my-site/known_hosts

# Public name of this service (gets its own certificate; point its A/AAAA records at the
# instance first) and the WordPress site's own name.
MCP_HOST=mcp.example.org
WP_HOST=example.org
# Shown on the consent screen and to the model. No quotes, $, backticks or backslashes.
SITE_NAME="Example Site"

# Optional: Let's Encrypt account e-mail for new certificates (expiry notices). Without it,
# certbot registers without an e-mail; on Bitnami the server's existing account is reused.
#ACME_EMAIL=you@example.org

# bin/bootstrap-site only: Polylang languages as WordPress locales, the first is the default.
#SITE_LANGUAGES=en_GB,es_ES

# Optional: a directory whose *.php files are installed as extra mu-plugins next to the
# bridge, e.g. a filter adding site-specific fields (see wpmcp_bridge_extra_fields).
#EXTRA_MU_PLUGINS=~/my-site/mu-plugins

# Optional overrides of deploy/wpmcp.env, appended to it as they are.
#WPMCP_CIDR_MODE=enforce
#WPMCP_WRITE_BUDGET=60
